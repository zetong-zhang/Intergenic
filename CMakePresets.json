{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default release build",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "zlib",
      "displayName": "Release build with gzip support",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build-zlib",
      "cacheVariables": {
        "INTERGENIC_USE_ZLIB": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "configuration": "Release"
    },
    {
      "name": "zlib",
      "configurePreset": "zlib",
      "configuration": "Release"
    }
  ]
}
